async def ffprobe_video(path: Path) -> dict:
    proc = await asyncio.create_subprocess_exec(
        "ffprobe", "-v", "quiet", "-print_format", "json", "-show_format", "-show_streams", str(path),
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
    )
    out, err = await proc.communicate()
    if proc.returncode != 0:
        raise RuntimeError(f"FFprobe failed: {err.decode(errors='ignore')}")
    info = json.loads(out.decode())
    vs = next((s for s in info.get("streams", []) if s.get("codec_type") == "video"), None)
    if not vs:
        raise ValueError("Uploaded file has no valid video stream.")
    aus = next((s for s in info.get("streams", []) if s.get("codec_type") == "audio"), None)
    dur = float(info.get("format", {}).get("duration") or vs.get("duration") or 0)
    if dur <= 0:
        raise ValueError("Invalid video duration.")
    return {
        "duration": dur,
        "width": int(vs.get("width", 0)),
        "height": int(vs.get("height", 0)),
        "has_audio": aus is not None,
    }


def slice_captions(transcript: list[dict], clip_start: float, clip_end: float, max_words: int = 5) -> list[dict]:
    words_in_range: list[dict] = []
    for seg in transcript:
        words = seg.get("words") or []
        if words:
            for w in words:
                ws, we = float(w["start"]), float(w["end"])
                if we > clip_start and ws < clip_end:
                    rs = max(0.0, ws - clip_start)
                    re_ = min(clip_end - clip_start, max(rs + 0.12, we - clip_start))
                    tok = w["word"].strip()
                    if tok:
                        words_in_range.append({"word": tok, "start": round(rs, 3), "end": round(re_, 3)})
        else:
            ss, se = float(seg["start"]), float(seg["end"])
            if se > clip_start and ss < clip_end:
                toks = seg["text"].strip().split()
                if toks:
                    rs, re_ = max(0.0, ss - clip_start), min(clip_end - clip_start, se - clip_start)
                    step = max(0.15, (re_ - rs) / len(toks))
                    for i, tok in enumerate(toks):
                        words_in_range.append({"word": tok, "start": round(rs + i * step, 3), "end": round(min(re_, rs + (i + 1) * step), 3)})

    cues = []
    for idx, i in enumerate(range(0, len(words_in_range), max_words)):
        chunk = words_in_range[i : i + max_words]
        if not chunk:
            continue
        cues.append({
            "seq_index": idx,
            "start_seconds": round(chunk[0]["start"], 3),
            "end_seconds": round(max(chunk[0]["start"] + 0.25, chunk[-1]["end"]), 3),
            "text": " ".join(x["word"] for x in chunk),
            "words_json": chunk,
        })
    return cues


def _transcribe_sync(wav_path: Path) -> list[dict]:
    model = get_whisper()
    segs, _ = model.transcribe(str(wav_path), beam_size=4, vad_filter=True, word_timestamps=True)
    out = []
    for s in segs:
        txt = s.text.strip()
        if not txt:
            continue
        words = [
            {"word": w.word.strip(), "start": round(float(w.start), 3), "end": round(float(w.end), 3)}
            for w in (s.words or []) if w.word.strip()
        ]
        out.append({"start": round(float(s.start), 3), "end": round(float(s.end), 3), "text": txt, "words": words})
    return out


def _gemini_sync(proxy_path: Path, title: str, duration: float, transcript: list[dict]) -> list[GeminiClip]:
    if not GEMINI_API_KEY:
        raise RuntimeError("GEMINI_API_KEY is missing in .env.")
    client = genai.Client(api_key=GEMINI_API_KEY)
    uploaded = None
    try:
        uploaded = client.files.upload(file=str(proxy_path))
        deadline = time.time() + 180
        while getattr(uploaded.state, "name", "") == "PROCESSING":
            if time.time() > deadline:
                raise TimeoutError("Gemini video processing timed out.")
            time.sleep(2)
            uploaded = client.files.get(name=uploaded.name)
        if getattr(uploaded.state, "name", "") == "FAILED":
            raise RuntimeError("Gemini failed to process video.")

        tr_lines = "\n".join(f"[{s['start']:.2f}s - {s['end']:.2f}s] {s['text']}" for s in transcript[:300]) or "(No speech detected)"
        prompt = f"""Analyze "{title}" (duration {duration:.2f}s) and this transcript:
{tr_lines}

Return 3 to 5 high-retention vertical 9:16 viral clip segments between 10s and 60s (or shorter only if total video < 12s).
Align start_seconds and end_seconds cleanly inside [0.0, {duration:.2f}]."""

        resp = client.models.generate_content(
            model=GEMINI_MODEL,
            contents=[uploaded, prompt],
            config=types.GenerateContentConfig(
                response_mime_type="application/json",
                response_schema=ViralAnalysisResult,
                temperature=0.35,
            ),
        )
        parsed = resp.parsed if isinstance(resp.parsed, ViralAnalysisResult) else ViralAnalysisResult.model_validate_json(resp.text)
        clean = []
        for c in parsed.clips:
            st = max(0.0, min(c.start_seconds, max(0.0, duration - 2.0)))
            en = min(duration, max(st + 2.0, c.end_seconds))
            if en - st >= 2.0:
                clean.append(GeminiClip(title=c.title[:100], start_seconds=round(st, 2), end_seconds=round(en, 2), viral_score=c.viral_score, hook_reason=c.hook_reason, tags=c.tags[:4]))
        return sorted(clean, key=lambda x: x.viral_score, reverse=True)
    finally:
        if uploaded is not None:
            try:
                client.files.delete(name=uploaded.name)
            except Exception:
                pass
        client.close()


# ---------- Background Pipelines ----------
async def run_analysis(project_id: str) -> None:
    job_dir = WORK_DIR / f"analyze_{project_id}"
    job_dir.mkdir(parents=True, exist_ok=True)
    chan = f"project:{project_id}"

    async def set_state(status: str, stage: str, progress: int, err: str | None = None) -> None:
        with get_db() as conn:
            conn.execute(
                "UPDATE projects SET status=?, current_stage=?, progress=?, error_message=? WHERE id=?",
                (status, stage, progress, err, project_id),
            )
        await bus.publish(chan, {"status": status, "stage": stage, "progress": progress, "message": err or ""})

    try:
        with get_db() as conn:
            proj = dict(conn.execute("SELECT * FROM projects WHERE id=?", (project_id,)).fetchone())
        src = Path(proj["source_path"])

        await set_state("ingesting", "Probing video metadata with FFprobe", 18)
        meta = await ffprobe_video(src)
        with get_db() as conn:
            conn.execute("UPDATE projects SET duration_seconds=?, width=?, height=? WHERE id=?", (meta["duration"], meta["width"], meta["height"], project_id))

        transcript: list[dict] = []
        if meta["has_audio"]:
            await set_state("transcribing", "Extracting audio & running Whisper STT", 38)
            wav = job_dir / "audio.wav"
            proc = await asyncio.create_subprocess_exec("ffmpeg", "-y", "-i", str(src), "-vn", "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", str(wav), stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
            await proc.communicate()
            if wav.exists():
                transcript = await asyncio.to_thread(_transcribe_sync, wav)

        await set_state("analyzing", "Preparing compact proxy for Gemini AI", 62)
        proxy = job_dir / "proxy.mp4"
        proc2 = await asyncio.create_subprocess_exec(
            "ffmpeg", "-y", "-i", str(src), "-vf", "scale=-2:480", "-r", "2", "-c:v", "libx264", "-preset", "ultrafast", "-crf", "32", "-c:a", "aac", "-b:a", "64k", str(proxy),
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
        )
        await proc2.communicate()
        target_for_ai = proxy if proxy.exists() and proxy.stat().st_size > 0 else src

        await set_state("analyzing", "Detecting viral hooks via Gemini AI", 76)
        clips = await asyncio.to_thread(_gemini_sync, target_for_ai, proj["title"], meta["duration"], transcript)
        if not clips:
            raise RuntimeError("AI found no valid clip segments.")

        await set_state("analyzing", "Synchronizing word-level captions", 92)
        with get_db() as conn:
            conn.execute("UPDATE projects SET transcript_json=? WHERE id=?", (json.dumps(transcript), project_id))
            conn.execute("DELETE FROM clips WHERE project_id=?", (project_id,))
            for c in clips:
                cid = str(uuid.uuid4())
                conn.execute(
                    "INSERT INTO clips (id, project_id, user_id, title, hook_reason, viral_score, tags_json, start_seconds, end_seconds) VALUES (?,?,?,?,?,?,?,?,?)",
                    (cid, project_id, proj["user_id"], c.title, c.hook_reason, c.viral_score, json.dumps(c.tags), c.start_seconds, c.end_seconds),
                )
                for cue in slice_captions(transcript, c.start_seconds, c.end_seconds):
                    conn.execute(
                        "INSERT INTO captions (id, clip_id, seq_index, start_seconds, end_seconds, text, words_json) VALUES (?,?,?,?,?,?,?)",
                        (str(uuid.uuid4()), cid, cue["seq_index"], cue["start_seconds"], cue["end_seconds"], cue["text"], json.dumps(cue["words_json"])),
                    )

        await set_state("ready", f"Ready! {len(clips)} viral clips detected", 100)
    except Exception as exc:
        await set_state("failed", "Analysis Failed", 0, str(exc))
    finally:
        shutil.rmtree(job_dir, ignore_errors=True)


def _fmt_ass_time(sec: float) -> str:
    sec = max(0.0, sec)
    h, rem = int(sec // 3600), sec % 3600
    m, s = int(rem // 60), rem % 60
    return f"{h}:{m:02d}:{int(s):02d}.{int(round((s - int(s))*100)):02d}"


def write_ass(captions: list[dict], pos: str, w: int, h: int, path: Path) -> None:
    align = 2 if pos == "bottom" else (5 if pos == "center" else 8)
    margin_v = 220 if pos == "bottom" else (80 if pos == "top" else 0)
    fsize = 62 if h >= 1500 else 42
    lines = [
        f"[Script Info]\nScriptType: v4.00+\nPlayResX: {w}\nPlayResY: {h}\n\n"
        f"[V4+ Styles]\nFormat: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\n"
        f"Style: Default,DejaVu Sans,{fsize},&H00FFFFFF,&H00FFE500,&H00000000,&H80000000,-1,0,0,0,100,100,0,0,1,4,2,{align},50,50,{margin_v},1\n\n"
        f"[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n"
    ]
    for cue in captions:
        txt = str(cue["text"]).replace("\n", "\\N").upper()
        lines.append(f"Dialogue: 0,{_fmt_ass_time(cue['start_seconds'])},{_fmt_ass_time(cue['end_seconds'])},Default,,0,0,0,,{txt}\n")
    path.write_text("".join(lines), encoding="utf-8")


async def run_export(clip_id: str, quality: str, crop_mode: str, caption_pos: str) -> None:
    job_dir = WORK_DIR / f"export_{clip_id}"
    job_dir.mkdir(parents=True, exist_ok=True)
    chan = f"clip:{clip_id}"

    async def set_exp(status: str, stage: str, progress: int, err: str | None = None, **extra) -> None:
        with get_db() as conn:
            fields = ["export_status=?", "export_stage=?", "export_progress=?", "export_error=?"]
            vals = [status, stage, progress, err]
            for k, v in extra.items():
                fields.append(f"{k}=?")
                vals.append(v)
            vals.append(clip_id)
            conn.execute(f"UPDATE clips SET {','.join(fields)} WHERE id=?", vals)
        await bus.publish(chan, {"status": status, "stage": stage, "progress": progress, "message": err or ""})

    try:
        with get_db() as conn:
            clip = dict(conn.execute("SELECT * FROM clips WHERE id=?", (clip_id,)).fetchone())
            proj = dict(conn.execute("SELECT * FROM projects WHERE id=?", (clip["project_id"],)).fetchone())
            captions = [dict(r) for r in conn.execute("SELECT * FROM captions WHERE clip_id=? ORDER BY seq_index ASC", (clip_id,)).fetchall()]

        src = Path(proj["source_path"])
        meta = await ffprobe_video(src)
        if quality == "1080p" and max(meta["width"], meta["height"]) >= 1080:
            tw, th = 1080, 1920
        else:
            tw, th = 720, 1280

        dur = max(0.5, float(clip["end_seconds"]) - float(clip["start_seconds"]))
        await set_exp("rendering", f"Rendering {tw}x{th} 9:16 MP4...", 15)

        if crop_mode == "fit_blur":
            base_vf = f"split[bg][fg];[bg]scale={tw}:{th}:force_original_aspect_ratio=increase,crop={tw}:{th},gblur=sigma=28[b];[fg]scale={tw}:{th}:force_original_aspect_ratio=decrease[f];[b][f]overlay=(W-w)/2:(H-h)/2"
        else:
            base_vf = f"scale={tw}:{th}:force_original_aspect_ratio=increase,crop={tw}:{th}"

        if captions:
            write_ass(captions, caption_pos, tw, th, job_dir / "captions.ass")
            vf = f"{base_vf},ass=captions.ass,format=yuv420p"
        else:
            vf = f"{base_vf},format=yuv420p"

        out_file = EXPORTS_DIR / f"{clip_id}.mp4"
        cmd = [
            "ffmpeg", "-y", "-ss", f"{clip['start_seconds']:.3f}", "-i", str(src), "-t", f"{dur:.3f}",
            "-vf", vf, "-c:v", "libx264", "-preset", "medium", "-crf", "19", "-movflags", "+faststart",
            "-c:a", "aac", "-b:a", "192k", "-progress", "pipe:1", "-nostats", str(out_file),
        ]
        proc = await asyncio.create_subprocess_exec(*cmd, cwd=str(job_dir), stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
        last_pct = 15
        assert proc.stdout is not None
        while True:
            raw = await proc.stdout.readline()
            if not raw:
                break
            line = raw.decode(errors="ignore").strip()
            if line.startswith("out_time_us="):
                try:
                    us = int(line.split("=", 1)[1])
                    pct = min(96, 15 + int((us / (dur * 1_000_000)) * 80))
                    if pct >= last_pct + 3:
                        last_pct = pct
                        await set_exp("rendering", f"Encoding MP4 ({pct}%)", pct)
                except ValueError:
                    pass
        _, err = await proc.communicate()
        if proc.returncode != 0 or not out_file.exists():
            raise RuntimeError(err.decode(errors="ignore")[-400:])

        final_meta = await ffprobe_video(out_file)
        res_label = f"{final_meta['width']}x{final_meta['height']}"
        await set_exp(
            "completed", "Export complete!", 100,
            export_path=str(out_file),
            export_resolution=res_label,
            export_size_bytes=out_file.stat().st_size,
        )
    except Exception as exc:
        await set_exp("failed", "Export failed", 0, str(exc))
    finally:
        shutil.rmtree(job_dir, ignore_errors=True)


