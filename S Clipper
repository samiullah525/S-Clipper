def validate_yt(url: str) -> tuple[str, str]:
    m = YOUTUBE_REGEX.match(url.strip())
    if not m:
        raise HTTPException(status_code=422, detail="Invalid YouTube URL (use watch?v=, youtu.be/, or shorts/).")
    vid = m.group(1)
    return vid, f"https://www.youtube.com/watch?v={vid}"


