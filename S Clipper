@app.post("/api/projects")
async def create_project(
    background_tasks: BackgroundTasks,
    youtube_url: str = Form(...),
    rights_confirmed: bool = Form(...),
    video_file: UploadFile | None = File(default=None),
    direct_url: str | None = Form(default=None),
    user: dict = Depends(get_current_user),
):
    if not rights_confirmed:
        raise HTTPException(422, "Please confirm you own or have rights to process this video.")
    vid, canonical = validate_yt(youtube_url)
    oembed = await fetch_oembed(canonical)

    pid = str(uuid.uuid4())
    dest = UPLOADS_DIR / f"{pid}.mp4"

    if video_file and video_file.filename:
        with dest.open("wb") as out:
            while chunk := await video_file.read(1024 * 512):
                out.write(chunk)
    elif direct_url and direct_url.strip().startswith(("http://", "https://")):
        async with httpx.AsyncClient(timeout=120.0, follow_redirects=True) as client:
            async with client.stream("GET", direct_url.strip()) as r:
                if r.status_code >= 400:
                    raise HTTPException(422, f"Direct URL download failed (HTTP {r.status_code}).")
                with dest.open("wb") as out:
                    async for chunk in r.aiter_bytes(256 * 1024):
                        out.write(chunk)
    else:
        raise HTTPException(422, "Please choose a video file from your device or paste a direct MP4 URL.")

    with get_db() as conn:
        conn.execute(
            "INSERT INTO projects (id, user_id, youtube_url, youtube_video_id, title, channel_name, thumbnail_url, source_path, status, progress, current_stage, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
            (pid, user["id"], canonical, vid, oembed["title"], oembed["channel_name"], oembed["thumbnail_url"], str(dest), "pending", 4, "Queued for AI analysis", time.time()),
        )
    background_tasks.add_task(run_analysis, pid)
    return {"id": pid, "title": oembed["title"], "status": "pending"}


