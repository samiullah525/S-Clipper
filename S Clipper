          <option value="fit_blur">9:16 Blur Fit</option>
        </select>
        <select id="stu-pos" onchange="saveTrimAndMode(false)">
          <option value="bottom">Captions: Bottom</option>
          <option value="center">Captions: Center</option>
          <option value="top">Captions: Top</option>
        </select>
      </div>
      <div class="row">
        <div><label class="muted">Start (sec)</label><input id="stu-start" type="number" step="0.1" /></div>
        <div><label class="muted">End (sec)</label><input id="stu-end" type="number" step="0.1" /></div>
      </div>
      <button class="btn outline" onclick="saveTrimAndMode(true)">Update Trim & Resync Captions</button>
    </div>

    <div class="card">
      <div class="row" style="margin-bottom:8px;">
        <h2 style="margin:0;">Synchronized Captions</h2>
        <button class="btn outline" style="width:auto;padding:6px 12px;" onclick="addCue()">+ Cue</button>
      </div>
      <div id="cues-list"></div>
      <div id="cap-msg" class="ok-txt"></div>
      <button class="btn" onclick="saveCaptions()">Save Captions</button>
    </div>

    <div class="card glow">
      <h2>Export 9:16 MP4</h2>
      <select id="exp-quality">
        <option value="1080p">1080p Full HD (1080x1920)</option>
        <option value="720p">720p Fast (720x1280)</option>
      </select>
      <div id="exp-prog-box" class="hidden">
        <p class="muted" id="exp-stage">Rendering...</p>
        <div class="progress-wrap"><div id="exp-bar" class="progress-bar" style="width:0%"></div></div>
      </div>
      <div id="exp-err" class="err-txt"></div>
      <a id="btn-download-mp4" class="btn hidden" style="display:block;text-align:center;text-decoration:none;margin-bottom:10px;" download>⬇ Download Exported MP4</a>
      <button id="btn-export" class="btn" onclick="triggerExport()">Render & Export MP4</button>
    </div>
  </div>
</div>

<div id="bottom-nav" class="nav hidden">
  <button onclick="go('home')" id="nav-home">🏠 Projects</button>
  <button onclick="go('import')" id="nav-import">➕ Import</button>
</div>

<script>
const state = {
  token: localStorage.getItem("vc_token") || "",
  isSignUp: false,
  projectId: null,
  clipId: null,
  clip: null,
  captions: [],
  sse: null
};

async function api(path, opts = {}) {
  const headers = opts.headers || {};
  if (state.token) headers["Authorization"] = "Bearer " + state.token;
  if (!(opts.body instanceof FormData) && opts.body && !headers["Content-Type"]) {
    headers["Content-Type"] = "application/json";
  }
  const r = await fetch(path, { ...opts, headers });
  const data = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(data.detail || "Request failed (" + r.status + ")");
  return data;
}

function go(screen) {
  ["auth", "home", "import", "analysis", "clips", "studio"].forEach(s => {
    document.getElementById("scr-" + s).classList.toggle("hidden", s !== screen);
  });
  const logged = !!state.token && screen !== "auth";
  document.getElementById("bottom-nav").classList.toggle("hidden", !logged);
  document.getElementById("btn-logout").classList.toggle("hidden", !logged);
  if (screen === "home") loadProjects();
}

function setAuthMode(signUp) {
  state.isSignUp = signUp;
  document.getElementById("auth-title").textContent = signUp ? "Create Account" : "Sign In";
  document.getElementById("auth-name").classList.toggle("hidden", !signUp);
}

async function submitAuth() {
  const err = document.getElementById("auth-err");
  err.textContent = "";
  try {
    const endpoint = state.isSignUp ? "/api/auth/register" : "/api/auth/login";
    const res = await api(endpoint, {
      method: "POST",
      body: JSON.stringify({
        email: document.getElementById("auth-email").value,
        password: document.getElementById("auth-pass").value,
        full_name: document.getElementById("auth-name").value
      })
    });
    state.token = res.token;
    localStorage.setItem("vc_token", state.token);
    go("home");
  } catch (e) { err.textContent = e.message; }
}

function logout() {
  state.token = "";
  localStorage.removeItem("vc_token");
  go("auth");
}

async function loadProjects() {
  const box = document.getElementById("projects-list");
  box.innerHTML = `<p class="muted">Loading...</p>`;
  try {
    const list = await api("/api/projects");
    if (!list.length) {
      box.innerHTML = `<div class="card"><p class="muted">No projects yet. Tap "+ Import New Video" to start!</p></div>`;
      return;
    }
    box.innerHTML = list.map(p => `
      <div class="card">
        <div class="row">
          <div style="flex:3;"><b>${esc(p.title)}</b><div class="muted" style="font-size:12px;">${esc(p.current_stage)} (${p.progress}%)</div></div>
          <span class="chip ${p.status==='ready'?'ok':(p.status==='failed'?'err':'')}">${p.status.toUpperCase()}</span>
        </div>
        ${p.error_message ? `<div class="err-txt">${esc(p.error_message)}</div>` : ""}
        <div class="row" style="margin-top:10px;">
          <button class="btn" onclick="${p.status==='ready' ? `openProjectClips('${p.id}')` : `watchAnalysis('${p.id}')`}">${p.status==='ready' ? 'View Viral Clips' : 'Open Status'}</button>
          <button class="btn danger" style="flex:0.4;" onclick="delProject('${p.id}')">Del</button>
        </div>
      </div>
    `).join("");
  } catch (e) {
    if (e.message.includes("session")) logout();
    else box.innerHTML = `<div class="err-txt">${esc(e.message)}</div>`;
  }
}

async function delProject(id) {
  await api("/api/projects/" + id, { method: "DELETE" });
  loadProjects();
}

async function validateYoutube() {
  const meta = document.getElementById("yt-meta");
  const err = document.getElementById("imp-err");
  meta.textContent = ""; err.textContent = "";
  try {
    const res = await api("/api/projects/validate-youtube?url=" + encodeURIComponent(document.getElementById("yt-url").value));
    meta.textContent = "Verified: " + res.title + (res.channel_name ? " (" + res.channel_name + ")" : "");
  } catch (e) { err.textContent = e.message; }
}

function startUploadAndAnalyze() {
  const err = document.getElementById("imp-err");
  err.textContent = "";
  const yt = document.getElementById("yt-url").value.trim();
  const file = document.getElementById("vid-file").files[0];
  const direct = document.getElementById("vid-direct").value.trim();
  const rights = document.getElementById("rights-chk").checked;
  if (!yt) { err.textContent = "Enter a YouTube URL."; return; }
  if (!rights) { err.textContent = "Confirm rights/ownership checkbox."; return; }
  if (!file && !direct) { err.textContent = "Select a video file or paste a direct MP4 URL."; return; }

  const fd = new FormData();
  fd.append("youtube_url", yt);
  fd.append("rights_confirmed", "true");
  if (file) fd.append("video_file", file);
  else fd.append("direct_url", direct);

  const xhr = new XMLHttpRequest();
  document.getElementById("imp-prog").classList.remove("hidden");
  document.getElementById("btn-start-ai").disabled = true;

  xhr.upload.onprogress = e => {
    if (e.lengthComputable) {
      const pct = Math.round((e.loaded / e.total) * 100);
      document.getElementById("imp-bar").style.width = pct + "%";
      document.getElementById("imp-prog-txt").textContent = "Uploading to server: " + pct + "%";
    }
  };
  xhr.onload = () => {
    document.getElementById("btn-start-ai").disabled = false;
    document.getElementById("imp-prog").classList.add("hidden");
    const res = JSON.parse(xhr.responseText || "{}");
    if (xhr.status >= 200 && xhr.status < 300) {
      watchAnalysis(res.id);
    } else {
      err.textContent = res.detail || "Upload failed";
    }
  };
  xhr.onerror = () => {
    document.getElementById("btn-start-ai").disabled = false;
    err.textContent = "Network error during upload.";
  };
  xhr.open("POST", "/api/projects");
  xhr.setRequestHeader("Authorization", "Bearer " + state.token);
  xhr.send(fd);
}

function watchAnalysis(projectId) {
  state.projectId = projectId;
  go("analysis");
  document.getElementById("ana-err").textContent = "";
  document.getElementById("btn-retry-ana").classList.add("hidden");
  if (state.sse) state.sse.close();
  state.sse = new EventSource(`/api/events/projects/${projectId}?token=${encodeURIComponent(state.token)}`);
  state.sse.onmessage = e => {
    const d = JSON.parse(e.data);
    document.getElementById("ana-pct").textContent = d.progress + "%";
    document.getElementById("ana-bar").style.width = d.progress + "%";
    document.getElementById("ana-stage").textContent = d.stage;
    if (d.status === "failed") {
      document.getElementById("ana-err").textContent = d.message;
      document.getElementById("btn-retry-ana").classList.remove("hidden");
      state.sse.close();
    } else if (d.status === "ready") {
      state.sse.close();
      openProjectClips(projectId);
    }
  };
}

async function retryCurrentProject() {
  await api(`/api/projects/${state.projectId}/retry`, { method: "POST" });
  watchAnalysis(state.projectId);
}

async function openProjectClips(projectId) {
  state.projectId = projectId;
  go("clips");
  const d = await api(`/api/projects/${projectId}`);
  document.getElementById("clips-proj-title").textContent = d.project.title;
  document.getElementById("clips-list").innerHTML = d.clips.map(c => `
    <div class="card ${c.viral_score>=85?'glow':''}">
      <div class="row">
        <b style="flex:3;">${esc(c.title)}</b>
        <span class="chip ok">VIRAL ${c.viral_score}%</span>
      </div>
      <div class="ok-txt">${c.start_seconds.toFixed(1)}s → ${c.end_seconds.toFixed(1)}s (${(c.end_seconds-c.start_seconds).toFixed(1)}s)</div>
      <p class="muted">${esc(c.hook_reason)}</p>
      <button class="btn" onclick="openStudio('${c.id}')">Open Clip Studio</button>
    </div>
  `).join("");
}

async function openStudio(clipId) {
  state.clipId = clipId;
  go("studio");
  const d = await api(`/api/clips/${clipId}`);
  state.clip = d.clip;
  state.captions = d.captions;
  document.getElementById("stu-title").textContent = d.clip.title;
  document.getElementById("stu-start").value = d.clip.start_seconds;
  document.getElementById("stu-end").value = d.clip.end_seconds;
  document.getElementById("stu-crop").value = d.clip.crop_mode;
  document.getElementById("stu-pos").value = d.clip.caption_position;

  const vid = document.getElementById("stu-video");
  vid.src = `/api/projects/${d.clip.project_id}/media?token=${encodeURIComponent(state.token)}#t=${d.clip.start_seconds},${d.clip.end_seconds}`;
  vid.ontimeupdate = () => {
    const rel = vid.currentTime - state.clip.start_seconds;
    if (vid.currentTime >= state.clip.end_seconds) { vid.currentTime = state.clip.start_seconds; }
    const cue = state.captions.find(x => rel >= x.start_seconds && rel <= x.end_seconds);
    const sub = document.getElementById("stu-sub");
    sub.className = "sub-overlay sub-" + document.getElementById("stu-pos").value;
    if (cue) { sub.textContent = cue.text.toUpperCase(); sub.classList.remove("hidden"); }
    else sub.classList.add("hidden");
  };
  document.getElementById("preview-box").classList.toggle("fit", d.clip.crop_mode === "fit_blur");
  renderCues();
  refreshExportUI(d.clip);
}

function renderCues() {
  document.getElementById("cues-list").innerHTML = state.captions.map((c, i) => `
    <div style="border-bottom:1px solid var(--border);padding:8px 0;">
      <div class="row" style="margin-bottom:6px;">
        <input type="number" step="0.1" value="${c.start_seconds}" onchange="state.captions[${i}].start_seconds=parseFloat(this.value)" />
        <input type="number" step="0.1" value="${c.end_seconds}" onchange="state.captions[${i}].end_seconds=parseFloat(this.value)" />
        <button class="btn danger" style="flex:0.4;padding:8px;" onclick="state.captions.splice(${i},1);renderCues()">✕</button>
      </div>
      <input value="${esc(c.text)}" onchange="state.captions[${i}].text=this.value" />
    </div>
  `).join("");
}

function addCue() {
  const last = state.captions[state.captions.length - 1];
  const st = last ? last.end_seconds : 0;
  state.captions.push({ seq_index: state.captions.length, start_seconds: st, end_seconds: st + 2, text: "New caption" });
  renderCues();
}

async function saveTrimAndMode(resync) {
  const crop = document.getElementById("stu-crop").value;
  const pos = document.getElementById("stu-pos").value;
  document.getElementById("preview-box").classList.toggle("fit", crop === "fit_blur");
  const payload = { crop_mode: crop, caption_position: pos };
  if (resync) {
    payload.start_seconds = parseFloat(document.getElementById("stu-start").value);
    payload.end_seconds = parseFloat(document.getElementById("stu-end").value);
  }
  const res = await api(`/api/clips/${state.clipId}`, { method: "PATCH", body: JSON.stringify(payload) });
  state.clip = res.clip;
  if (resync) {
    state.captions = res.captions;
    renderCues();
    document.getElementById("stu-video").currentTime = res.clip.start_seconds;
  }
}

async function saveCaptions() {
  const msg = document.getElementById("cap-msg");
  msg.textContent = "";
  const res = await api(`/api/clips/${state.clipId}/captions`, {
    method: "PUT",
    body: JSON.stringify({ captions: state.captions })
  });
  state.captions = res.captions;
  renderCues();
  msg.textContent = "Captions saved!";
}

function refreshExportUI(clip) {
  const dl = document.getElementById("btn-download-mp4");
  if (clip.export_status === "completed") {
    dl.href = `/api/clips/${clip.id}/download?token=${encodeURIComponent(state.token)}`;
    dl.textContent = `⬇ Download ${clip.export_resolution || ''} MP4 (${(clip.export_size_bytes/(1024*1024)).toFixed(1)} MB)`;
    dl.classList.remove("hidden");
  } else {
    dl.classList.add("hidden");
  }
}

async function triggerExport() {
  document.getElementById("e
