@app.patch("/api/clips/{clip_id}")
async def update_clip(clip_id: str, body: UpdateClipBody, user: dict = Depends(get_current_user)):
    with get_db() as conn:
        clip = conn.execute("SELECT * FROM clips WHERE id=? AND user_id=?", (clip_id, user["id"])).fetchone()
        if not clip:
            raise HTTPException(404, "Clip not found.")
        proj = conn.execute("SELECT duration_seconds, transcript_json FROM projects WHERE id=?", (clip["project_id"],)).fetchone()
        max_d = float(proj["duration_seconds"] or 3600)
        ns = max(0.0, min(body.start_seconds if body.start_seconds is not None else clip["start_seconds"], max_d - 1.0))
        ne = min(max_d, max(ns + 1.0, body.end_seconds if body.end_seconds is not None else clip["end_seconds"]))
        cm = body.crop_mode or clip["crop_mode"]
        cp = body.caption_position or clip["caption_position"]
        conn.execute("UPDATE clips SET start_seconds=?, end_seconds=?, crop_mode=?, caption_position=? WHERE id=?", (round(ns, 2), round(ne, 2), cm, cp, clip_id))
        if body.start_seconds is not None or body.end_seconds is not None:
            tr = json.loads(proj["transcript_json"] or "[]")
            conn.execute("DELETE FROM captions WHERE clip_id=?", (clip_id,))
            for cue in slice_captions(tr, ns, ne):
                conn.execute(
                    "INSERT INTO captions (id, clip_id, seq_index, start_seconds, end_seconds, text, words_json) VALUES (?,?,?,?,?,?,?)",
                    (str(uuid.uuid4()), clip_id, cue["seq_index"], cue["start_seconds"], cue["end_seconds"], cue["text"], json.dumps(cue["words_json"])),
                )
        updated = dict(conn.execute("SELECT * FROM clips WHERE id=?", (clip_id,)).fetchone())
        caps = [dict(r) for r in conn.execute("SELECT * FROM captions WHERE clip_id=? ORDER BY seq_index ASC", (clip_id,)).fetchall()]
    return {"clip": updated, "captions": caps}


